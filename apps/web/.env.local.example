# Base URL of services/api. `npm run dev` from the repo root starts it on
# this port alongside the web app.
#
# Two variables do this job, and which one you want depends on whether the
# backend's address is known when the bundle is built:
#
#   NEXT_PUBLIC_API_URL  — inlined at build time. Right for local dev and for
#                          a deploy whose backend never moves. Wins when set.
#   CODEAXIS_API_URL     — read at runtime by /api/config (server-side only,
#                          never inlined). Use this on a deployment so the
#                          backend can be re-pointed without rebuilding; leave
#                          NEXT_PUBLIC_API_URL unset there or it takes
#                          precedence.
#
# With neither set, the client falls back to http://localhost:8000.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Clerk (Auth). Dashboard -> API Keys. Same publishable key also goes in the
# root .env as CLERK_PUBLISHABLE_KEY, for the FastAPI backend's JWT verification.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/
