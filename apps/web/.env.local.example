# Base URL of services/api (uv run uvicorn app.main:app --reload)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Clerk (Auth). Dashboard -> API Keys. Same publishable key also goes in the
# root .env as CLERK_PUBLISHABLE_KEY, for the FastAPI backend's JWT verification.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/
