{
  "name": "codeaxis",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently --names api,web --prefix-colors cyan,magenta --kill-others-on-fail \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "uv run --directory services/api uvicorn app.main:app --reload --port 8000",
    "dev:web": "npm run dev -w @codeaxis/web",
    "build:web": "npm run build -w @codeaxis/web",
    "lint:web": "npm run lint -w @codeaxis/web",
    "test:web": "npm run test -w @codeaxis/web",
    "db:push": "node --env-file-if-exists=.env scripts/db-push.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "supabase": "^2.120.0"
  }
}
