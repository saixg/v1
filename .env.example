# Copy to .env (gitignored). Supabase dashboard -> Connect.

# Session pooler (port 5432), project owner role. Used by migrations
# (supabase db push) and scripts/setup_db_roles.py only — never by a service.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres
# codeaxis_worker role: read/write on the codeaxis schema. Used by services/worker.
# Created by `uv run python scripts/setup_db_roles.py`.
WORKER_DATABASE_URL=
# codeaxis_api role: read-only on the codeaxis schema. Used by services/api.
# Created by `uv run python scripts/setup_db_roles.py`.
API_DATABASE_URL=

SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable key: web auth + API JWT verification.
SUPABASE_PUBLISHABLE_KEY=
# Secret key: worker only (Storage uploads). Never give this to the sandbox or the web app.
SUPABASE_SECRET_KEY=
