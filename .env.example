# Copy to .env (gitignored). Supabase dashboard -> Connect.

# Session pooler (port 5432), project owner role. Used by migrations
# (supabase db push) and scripts/setup_db_roles.py only — never by the app.
DATABASE_URL=
# codeaxis_worker role: read/write on the codeaxis schema. Used by app.analysis / app.repository.
# Created by `uv run python scripts/setup_db_roles.py`.
WORKER_DATABASE_URL=
# codeaxis_api role: read-only on the codeaxis schema. Used by the FastAPI read routes.
# Created by `uv run python scripts/setup_db_roles.py`.
API_DATABASE_URL=

# Supabase project (database only — Auth is Clerk, see CLERK_* below).
SUPABASE_URL=
# Secret key: reserved for future Storage uploads. Never give this to the sandbox or the web app.
SUPABASE_SECRET_KEY=

# Clerk (Auth). The publishable key is enough for JWT verification — its
# payload encodes the Frontend API host that JWKS lives under (app/auth.py),
# which is why no secret key appears here.
#
# This exact name is what `app/auth.py` reads, and auth fails closed (503)
# without it. The frontend needs the same value under its own
# NEXT_PUBLIC_-prefixed name, but that belongs in apps/web/.env.local (see
# apps/web/.env.local.example) — Next.js does not read this file, and
# renaming this one to the NEXT_PUBLIC_ form takes the backend's auth down.
CLERK_PUBLISHABLE_KEY=
# Comma-separated browser origins allowed to use this backend. Does double
# duty: checked against a token's `azp` claim (app/auth.py) and used as the
# CORS allowlist (app/main.py). A deployed API must set this to the web
# app's real origin — left at the default, a hosted frontend gets a CORS
# failure. '*' is rejected at startup: this API is always called with an
# Authorization header, and the CORS spec forbids '*' with credentials.
CLERK_ALLOWED_ORIGINS=http://localhost:3000

# Semicolon-separated absolute directories local-path ingestion (POST
# /repos/stage with "kind": "local") may read from. Unset/empty (the
# default) disables local-path ingestion entirely: any authenticated user
# can otherwise reach it by creating their own project, turning it into an
# arbitrary-host-path read. Set this only on a single-operator/dev
# deployment, to directories you explicitly trust.
LOCAL_INGEST_ALLOWED_ROOTS=

# Which completion provider app.llm.model_service() uses: "gemini" or
# "anthropic". Unset picks whichever key below is set, Gemini first; an
# unrecognised value is an error rather than a silent fallback. The role ->
# model routing table follows the provider (app/llm/routing.py), so this one
# variable switches vendors with no code change.
#
# Gemini is a deliberate override of build-plan.md Part 3's Claude routing
# table, recorded in docs/STATUS.md (2026-10-20): it is the provider the
# project can currently authenticate.
CODEAXIS_LLM_PROVIDER=gemini

# Anthropic API key for app.llm.ModelService (build-plan.md Part 3). Worker only.
# Unset is fine for tests: every test mocks the provider; nothing calls the API.
ANTHROPIC_API_KEY=

# Google Gemini API key for app.llm.ModelService, used when
# CODEAXIS_LLM_PROVIDER is "gemini". Worker only. Sent as the x-goog-api-key
# header (this endpoint rejects a Bearer token with a 401).
# Unset is fine for tests: every test mocks the HTTP call.
GEMINI_API_KEY=

# Voyage AI API key for the `embed` role (voyage-code-3, build-plan.md Part 3
# / Part 13 #2, decided 2026-10-17). Worker only.
# Unset is fine: the chunk pass still runs, chunks are stored with no vector
# and stay keyword-searchable, and the gap is recorded in codeaxis.coverage.
# Every test mocks the provider; nothing calls the API.
VOYAGE_API_KEY=
# ---------------------------------------------------------------- Phase 6
# Cost caps and rate limits (build-plan.md Part 10 Phase 6).

# Deployment-wide model spend ceiling per project, per UTC calendar month, in
# USD. A project overrides it with codeaxis.projects.monthly_cost_cap_usd; a
# NULL there means "use this value", never "unlimited". Enforced before every
# provider call (app/limits/budget.py), read from the append-only
# codeaxis.llm_calls ledger. Default 10.00 when unset; a malformed value is a
# startup error rather than an uncapped run.
CODEAXIS_PROJECT_MONTHLY_COST_CAP_USD=10.00

# Per-identity request rate limits, as "<count>/<seconds>". Optional: unset
# uses the defaults in app/limits/ratelimit.py (DEFAULT_BUCKETS). These
# counters live in the API process's memory, so the limit is PER MACHINE, not
# global -- see that module's docstring.
# CODEAXIS_RATE_LIMIT_INGEST=10/3600
# CODEAXIS_RATE_LIMIT_CHAT=15/60
# CODEAXIS_RATE_LIMIT_SEARCH=60/60
# CODEAXIS_RATE_LIMIT_EXTRACT=30/3600
# CODEAXIS_RATE_LIMIT_BLUEPRINT=60/3600
# CODEAXIS_RATE_LIMIT_MCP=120/60
# CODEAXIS_RATE_LIMIT_READ=300/60

# Database connection pool ceilings, per process (app/knowledge/db.py). Sized
# for a small container; uvicorn workers and Fly machines multiply them, as
# does the Supabase pooler's own limit. Unset uses 10 (api) and 5 (worker).
# CODEAXIS_DB_POOL_MAX_API=10
# CODEAXIS_DB_POOL_MAX_WORKER=5
